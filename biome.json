{
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/node_modules",
			"!docs/design",
			"!packages/ui/components/src/ambient/vendor",
			"!test-results",
			"!e2e/report",
			"!.e2e",
			"!.kit",
			"!apps/desktop/src-tauri/gen",
			"!apps/desktop/src-tauri/target",
			"!apps/desktop/src-tauri/Cargo.lock",
			"!plugins/meeting-recorder/permissions/autogenerated",
			"!plugins/meeting-recorder/permissions/schemas",
			"!plugins/meeting-recorder/target",
			"!plugins/meeting-recorder/.tauri",
			"!plugins/meeting-recorder/android/.tauri",
			"!plugins/meeting-recorder/ios/.build",
			"!plugins/meeting-recorder/android/.gradle",
			"!plugins/meeting-recorder/android/build",
			"!scripts/native-contacts-test/gen",
			"!scripts/native-contacts-test/target",
			"!scripts/native-meeting-test/gen",
			"!scripts/native-meeting-test/target"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"overrides": [
		{
			"includes": ["apps/web/**/*.css", "packages/ui/**/*.css"],
			"css": {
				"parser": {
					"tailwindDirectives": true
				}
			}
		}
	]
}
