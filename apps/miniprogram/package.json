{
	"name": "@yonder/miniprogram",
	"private": true,
	"version": "0.3.26111505",
	"type": "module",
	"scripts": {
		"dev": "taro build --type weapp --watch",
		"build": "taro build --type weapp",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts && node --test src/components/*.test.mjs config/*.test.mjs",
		"predev": "node src/styles/generate-tokens.mjs",
		"prebuild": "node src/styles/generate-tokens.mjs",
		"build:preview": "taro build --type h5",
		"prebuild:preview": "node src/styles/generate-tokens.mjs",
		"serve:preview": "node scripts/serve-preview.mjs"
	},
	"dependencies": {
		"@tarojs/components": "4.3.3",
		"@tarojs/react": "4.3.3",
		"@tarojs/runtime": "4.3.3",
		"@tarojs/shared": "4.3.3",
		"@tarojs/taro": "4.3.3",
		"@yonder/api-client": "file:../../packages/api-client",
		"@yonder/auth-presentation": "file:../../packages/ui/auth-presentation",
		"@yonder/chat-model": "file:../../packages/ui/chat-model",
		"@yonder/chat-presentation": "file:../../packages/ui/chat-presentation",
		"@yonder/feature-legal": "file:../../packages/ui/features/legal",
		"@yonder/protocol": "file:../../packages/protocol",
		"@yonder/ui-time": "file:../../packages/ui/time",
		"markdown-to-jsx": "9.10.6",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@babel/preset-react": "^7.29.7",
		"@tarojs/cli": "4.3.3",
		"@tarojs/plugin-framework-react": "4.3.3",
		"@tarojs/plugin-platform-h5": "4.3.3",
		"@tarojs/plugin-platform-weapp": "4.3.3",
		"@tarojs/webpack5-runner": "4.3.3",
		"@types/react": "18.3.23",
		"@types/react-dom": "18.3.7",
		"babel-preset-taro": "4.3.3",
		"sass": "^1.89.0",
		"webpack": "5.91.0"
	}
}
