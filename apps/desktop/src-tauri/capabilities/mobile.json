{
	"identifier": "mobile",
	"windows": ["main"],
	"platforms": ["android", "iOS"],
	"permissions": [
		"core:default",
		"core:app:allow-exit",
		"meeting-recorder:default",
		"yonder-device-download:allow-open",
		"yonder-device-download:allow-share",
		"yonder-device-download:allow-copy",
		"yonder-device-info:default",
		"yonder-notifications:default",
		"haptics:allow-impact-feedback",
		"haptics:allow-notification-feedback",
		"haptics:allow-selection-feedback",
		"yonder-ios-chat-attachments:default"
	]
}
