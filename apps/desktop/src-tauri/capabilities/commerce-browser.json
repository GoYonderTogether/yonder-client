{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "commerce-browser",
	"description": "The main desktop window opens official Alipay checkout in the default browser.",
	"windows": ["main"],
	"platforms": ["macOS", "windows"],
	"permissions": [
		{
			"identifier": "opener:allow-open-url",
			"allow": [{ "url": "https://openapi.alipay.com/gateway.do[?]*" }],
			"deny": [{ "url": "https://openapi.alipay.com/gateway.do[?]*[#]*" }]
		}
	]
}
