{
	"name": "yonder-client",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"workspaces": [
		"apps/web",
		"packages/protocol",
		"packages/api-client",
		"packages/ui/tokens",
		"packages/ui/i18n",
		"packages/ui/chat-model",
		"packages/ui/chat-presentation",
		"packages/ui/auth-presentation",
		"packages/ui/components",
		"packages/ui/data",
		"packages/ui/shell",
		"packages/ui/features/auth",
		"packages/ui/features/legal",
		"packages/ui/features/me",
		"packages/ui/features/members",
		"packages/ui/features/landing",
		"packages/ui/features/meetings"
	],
	"scripts": {
		"dev:web": "npm run dev -w @yonder/web",
		"build": "npm run build -w @yonder/web",
		"typecheck": "tsc -b --force",
		"test": "npm run test:unit && npm run test:release",
		"test:unit": "vitest run",
		"test:release": "node --test scripts/release/*.test.mjs",
		"lint": "biome check .",
		"check": "npm run lint && npm run typecheck && npm run test && node tools/check-entry-imports.mjs && node tools/check-dependency-direction.mjs && node tools/check-file-length.mjs && node tools/check-tailwind-sources.mjs && node tools/check-ui-raw-values.mjs && npm run check:miniprogram",
		"check:entry-imports": "node tools/check-entry-imports.mjs",
		"check:dependency-direction": "node tools/check-dependency-direction.mjs",
		"check:file-length": "node tools/check-file-length.mjs",
		"check:tailwind-sources": "node tools/check-tailwind-sources.mjs",
		"check:ui-raw-values": "node tools/check-ui-raw-values.mjs",
		"e2e": "playwright test",
		"e2e:serve": "node scripts/e2e/serve.mjs",
		"version:check": "node scripts/version-check.mjs --check",
		"dev": "npm run dev:web",
		"dev:miniprogram": "npm run dev --prefix apps/miniprogram",
		"build:miniprogram": "npm run build --prefix apps/miniprogram",
		"check:miniprogram": "npm run typecheck --prefix apps/miniprogram && npm run test --prefix apps/miniprogram"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@playwright/test": "1.65.0",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.10",
		"@types/node": "26.6.6",
		"jsdom": "31.0.1",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"version": "0.3.26112815",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/GoYonderTogether/yonder-client.git"
	}
}
